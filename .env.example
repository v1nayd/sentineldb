# SentinelDB — environment template. Copy to .env and replace every placeholder.
# .env is git-ignored. Never commit real secrets. Passwords below are placeholders, not defaults.
# Do NOT add NODE_ENV here: Next.js manages it itself and a non-standard value breaks `next build`.

# --- MySQL 8.x (authoritative store) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sentineldb
# DDL / migrations / seeding only. Never used by the web app at runtime.
MYSQL_MIGRATOR_USER=sentinel_migrator
MYSQL_MIGRATOR_PASSWORD=replace-me-migrator
# Runtime web-app account. Per-table/column least privilege (db/grants.sql.tpl, applied by scripts/apply-grants.sh).
MYSQL_APP_USER=sentinel_app
MYSQL_APP_PASSWORD=replace-me-app
# Same grants as the runtime account but only on the *_test schema; used by `npm test`.
MYSQL_APP_TEST_USER=sentinel_app_test
MYSQL_APP_TEST_PASSWORD=replace-me-app-test
# Command used by scripts/bootstrap-db.sh to get a root shell (local dev only).
# Native MySQL via socket:  mysql -uroot
# Docker Compose:           docker compose exec -T mysql mysql -uroot -p"$MYSQL_ROOT_PASSWORD"
MYSQL_ROOT_CMD="mysql -uroot"
# Only used by docker-compose.yml to initialise the container.
MYSQL_ROOT_PASSWORD=replace-me-root

# --- Qdrant (vector index; derived data, rebuildable from MySQL) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=incident_narratives
# Docker Compose only: host port of the Qdrant container. Keep it equal to the port in QDRANT_URL.
QDRANT_PORT=6333

# --- Embedding model (local, no external API) ---
EMBEDDING_MODEL_DIR=./models/all-MiniLM-L6-v2
